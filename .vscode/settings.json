{
    "search.useIgnoreFiles": false, // Disable respecting .gitignore
    "search.exclude": {
        "**/build": true,
        "**/external": false
    },
    "cmake.configureSettings": {
        "SINGULARITY_BUILD_EXAMPLES": true,
        "SMTG_ENABLE_VST3_HOSTING_EXAMPLES":true,
    },

    "qt-qml.qmlls.customExePath": "/usr/bin/qmlls",
    "qt-qml.qmlls.customArgs": [
        "--build-dir",
        "${workspaceFolder}/build"
    ],
    "cmake.options.statusBarVisibility": "visible",
    // "cmake.buildDirectory": "${workspaceFolder}/builds/${buildKit}/${buildType}"
}
