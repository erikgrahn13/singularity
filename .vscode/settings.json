{
    "search.useIgnoreFiles": false, // Disable respecting .gitignore
    "search.exclude": {
        "**/build": true,
        "**/external": false
    },
    "cmake.configureSettings": {
        "SINGULARITY_BUILD_EXAMPLES": true,
        "SMTG_ENABLE_VST3_HOSTING_EXAMPLES":true,
        "XCODE_VERSION": "27.0"
    },
    "cmake.configureEnvironment": {
        "XCODE_VERSION": "27.0"
    },

    "qt-qml.qmlls.customExePath": "/usr/bin/qmlls",
    "qt-qml.preview.additionalBuildDirs": [
        "${workspaceFolder}/build"
    ],
    "cmake.debugConfig": {
        "environment": [
            {
                "name": "SINGULARITY_QML_PREVIEW_PORT",
                "value": "12150"
            },
            {
                "name": "QT_LOGGING_RULES",
                "value": "qml.debug=true;js.debug=true"
            },
            {
                "name": "QT_FORCE_STDERR_LOGGING",
                "value": "1"
            }
        ]
    },
    "qt-qml.qmlls.customArgs": [
        "--build-dir",
        "${workspaceFolder}/build"
    ],
    "cmake.options.statusBarVisibility": "visible",
}
