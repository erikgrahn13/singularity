{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install standalone plugin",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--install",
                "${workspaceFolder}/build",
                "--config",
                "Release",
                "--component",
                "${input:standalonePlugin}Standalone",
                "--prefix",
                "${workspaceFolder}/build/examples/${input:standalonePlugin}/out/APP"
            ],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "standalonePlugin",
            "type": "pickString",
            "description": "Standalone plugin to install",
            "options": [
                "ExampleEffect",
                "ExampleInstrument"
            ],
            "default": "ExampleEffect"
        }
    ]
}