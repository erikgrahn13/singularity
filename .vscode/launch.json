{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "VST3PluginTestHost Mac",
            "type": "cppdbg",
            "request": "launch",
            "program": "/Applications/VST3PluginTestHost.app",
            "args": ["--pluginfolder", "${command:cmake.buildDirectory}/vst3/Debug"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build",
            "externalConsole": false,
            "MIMode": "lldb"
        },
        {
            "name": "EditorHost Mac",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.buildDirectory}/bin/Debug/editorhost.app/Contents/MacOS/editorhost",
            "args": ["${command:cmake.buildDirectory}/examples/ExampleEffect/out/VST3/Debug/Example Effect.vst3"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build",
            "externalConsole": false,
            "MIMode": "lldb",
            "environment": [
                { "name": "QSG_INFO", "value": "1" },
                { "name": "QSG_RHI_BACKEND", "value": "metal" }
            ],
        },
        {
            "name": "EditorHost Linux ExampleEffect",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.buildDirectory}/bin/${command:cmake.buildType}/editorhost",
            "args": ["${command:cmake.buildDirectory}/examples/ExampleEffect/out/VST3/${command:cmake.buildType}/Example Effect.vst3"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/examples/ExampleEffect",
            "preLaunchTask": "CMake: build",
            "externalConsole": false,
            "MIMode": "gdb",
            "symbolLoadInfo": {
                "loadAll": false,
                "exceptionList": "*Example*;*singularity*;*editorhost*"
            },
            "setupCommands": [
                { "text": "set debuginfod enabled off", "ignoreFailures": true }
            ]
        },
        {
            "name": "EditorHost MacOS ExampleEffect QML Preview",
            "type": "cppdbg",
            "request": "launch",
            "program": "/opt/homebrew/bin/qmlpreview",
            "args": [
                "${command:cmake.buildDirectory}/bin/${command:cmake.buildType}/editorhost.app/Contents/MacOS/editorhost",
                "${command:cmake.buildDirectory}/examples/ExampleEffect/out/VST3/${command:cmake.buildType}/Example Effect.vst3"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/examples/ExampleEffect",
            "preLaunchTask": "CMake: build",
            "externalConsole": false,
            "MIMode": "lldb",
            "targetArchitecture": "arm64",
            "symbolLoadInfo": {
                "loadAll": false,
                "exceptionList": "*Example*;*singularity*;*editorhost*"
            },
            "setupCommands": [
                {
                    "description": "Keep QML Preview running after it launches EditorHost",
                    "text": "set detach-on-fork on",
                    "ignoreFailures": false
                },
                {
                    "description": "Debug EditorHost and the loaded VST3",
                    "text": "set follow-fork-mode child",
                    "ignoreFailures": false
                },
                {
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "EditorHost Linux ExampleEffect QML Preview",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/lib64/qt6/bin/qmlpreview",
            "args": [
                "${command:cmake.buildDirectory}/bin/${command:cmake.buildType}/editorhost",
                "${command:cmake.buildDirectory}/examples/ExampleEffect/out/VST3/${command:cmake.buildType}/Example Effect.vst3"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/examples/ExampleEffect",
            "preLaunchTask": "CMake: build",
            "externalConsole": false,
            "MIMode": "gdb",
            "symbolLoadInfo": {
                "loadAll": false,
                "exceptionList": "*Example*;*singularity*;*editorhost*"
            },
            "setupCommands": [
                {
                    "description": "Keep QML Preview running after it launches EditorHost",
                    "text": "set detach-on-fork on",
                    "ignoreFailures": false
                },
                {
                    "description": "Debug EditorHost and the loaded VST3",
                    "text": "set follow-fork-mode child",
                    "ignoreFailures": false
                },
                {
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "EditorHost Linux ExampleInstrument",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.buildDirectory}/bin/Debug/editorhost",
            "args": ["${command:cmake.buildDirectory}/examples/ExampleInstrument/out/VST3/Debug/ExampleInstrument.vst3"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/examples/ExampleInstrument",
            "preLaunchTask": "CMake: build",
            "externalConsole": false,
            "MIMode": "gdb",
            "symbolLoadInfo": {
                "loadAll": false,
                "exceptionList": "*Example*;*singularity*;*editorhost*"
            },
            "setupCommands": [
                { "text": "set debuginfod enabled off", "ignoreFailures": true }
            ]
        },
        {
            "name": "Editorhost Windows",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.buildDirectory}/bin/Debug/editorhost.exe",
            "args": ["${command:cmake.buildDirectory}/VST3/Debug/ExamplePlugin.vst3"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "console": "newExternalWindow",
            "preLaunchTask": "CMake: build"
        },
        {
            "name": "ExamplePlugin APP Windows",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}/examples/ExampleEffect",
            "environment": [],
            "args": []
        },
        {
            "name": "ExamplePlugin APP Mac",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}/examples/ExampleEffect",
            "environment": [],
            "args": [],
            "MIMode": "lldb"
        },
        {
            "name": "ExampleEffect APP Linux",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "cwd": "${workspaceFolder}/examples/ExampleEffect",
            "environment": [],
            "args": [],
            "MIMode": "gdb"
        },
        {
            "name": "ExampleEffect APP QML Preview Linux",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/lib64/qt6/bin/qmlpreview",
            "args": [
                "${command:cmake.launchTargetPath}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/examples/ExampleEffect",
            "preLaunchTask": "CMake: build",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Keep QML Preview running after it launches the application",
                    "text": "set detach-on-fork on",
                    "ignoreFailures": false
                },
                {
                    "description": "Debug the application launched by QML Preview",
                    "text": "set follow-fork-mode child",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}
