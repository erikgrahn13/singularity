{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AudioHost Linux ExampleEffect",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.buildDirectory}/bin/${command:cmake.buildType}/audiohost",
            "args": ["${command:cmake.buildDirectory}/examples/ExampleEffect/out/VST3/${command:cmake.buildType}/Example Effect.vst3"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/examples/ExampleEffect",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "VST3PluginTestHost Mac",
            "type": "cppdbg",
            "request": "launch",
            "program": "/Applications/VST3PluginTestHost.app",
            "args": ["--pluginfolder", "${command:cmake.buildDirectory}/examples/ExampleEffect/out/VST3/Debug/"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build",
            "externalConsole": false,
            "MIMode": "lldb"
        },
        {
            "name": "Editorhost Windows",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.buildDirectory}/bin/Debug/editorhost.exe",
            "args": ["${command:cmake.buildDirectory}/VST3/Debug/ExamplePlugin.vst3"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "console": "newExternalWindow",
            "preLaunchTask": "CMake: build"
        },
        {
            "name": "REAPER Linux",
            "type": "cppdbg",
            "request": "launch",
            "program": "/opt/REAPER/reaper",
            "args": [],
            "environment": [
                {
                    "name": "SINGULARITY_QML_PREVIEW_PORT",
                    "value": "12150"
                },
                {
                    "name": "QT_LOGGING_RULES",
                    "value": "qml.debug=true;js.debug=true"
                },
                {
                    "name": "QT_FORCE_STDERR_LOGGING",
                    "value": "1"
                }
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",

            "preLaunchTask": "CMake: build",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "EditorHost ExampleEffect",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.buildDirectory}/bin/${command:cmake.buildType}/editorhost",
            "args": ["${command:cmake.buildDirectory}/examples/ExampleEffect/out/VST3/${command:cmake.buildType}/Example Effect.vst3"],
            "osx": {
                "program": "${command:cmake.buildDirectory}/bin/${command:cmake.buildType}/editorhost.app/Contents/MacOS/editorhost",
                "MIMode": "lldb",
                "setupCommands": []
            },
            "environment": [
                {
                    "name": "SINGULARITY_QML_PREVIEW_PORT",
                    "value": "12150"
                },
                {
                    "name": "QT_LOGGING_RULES",
                    "value": "qml.debug=true;js.debug=true"
                },
                {
                    "name": "QT_FORCE_STDERR_LOGGING",
                    "value": "1"
                }
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",

            "preLaunchTask": "CMake: build",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
